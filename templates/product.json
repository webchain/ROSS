          "settings": {
            "show_crumbs": true
          }
        },
        "ross_chips": {
          "type": "ross_chips",
          "settings": {}
        },
        "ross_intro": {
          "type": "ross_intro",
          "settings": {}
        },
        "usp": {
          "type": "text",
          "settings": {
            "text": "Vers gebrand · Gratis verzending vanaf €75 · Afhalen in Kruibeke of Melsele",
            "text_style": "body"
          }
        }
      },
      "block_order": [
        "ross_title",
        "title",
        "ross_chips",
        "ross_intro",
        "price",
        "variant_picker",
        "quantity_selector",
        "buy_buttons",
        "usp",
        "description",
        "share"
