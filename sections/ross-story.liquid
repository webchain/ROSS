<section class="ross-story color-{{ section.settings.color_scheme }}">
  <div class="ross-story__media">
    {%- render 'ross-image',
      image: section.settings.image,
      fallback: section.settings.fallback,
      alt: section.settings.image_alt,
      position: section.settings.image_position,
      sizes: '(min-width: 990px) 50vw, 100vw'
    -%}
  </div>
  <div class="ross-story__text">
    {%- if section.settings.script != blank -%}
      <p class="ross-script ross-kicker ross-kicker--yellow">{{ section.settings.script | escape }}</p>
    {%- endif -%}
    <h2 class="ross-h2">{{ section.settings.heading | escape }}</h2>
    {%- if section.settings.text != blank -%}
      <div class="ross-lead rte">{{ section.settings.text }}</div>
    {%- endif -%}
    {%- if section.blocks.size > 0 -%}
      <div class="ross-stats">
        {%- for block in section.blocks -%}
          <div {{ block.shopify_attributes }}>
            <strong>{{ block.settings.number | escape }}</strong>
            <span>{{ block.settings.label | escape }}</span>
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
    {%- if section.settings.link_label != blank -%}
      <a href="{{ section.settings.link | default: '#' }}" class="ross-link ross-link--yellow">{{ section.settings.link_label | escape }}</a>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "ROSS · Verhaal",
  "tag": "div",
  "class": "section ross-section",
  "max_blocks": 4,
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Foto" },
    { "type": "text", "id": "fallback", "label": "Standaardfoto (themabestand)", "default": "ross-wim-en-sabrina-branderij.jpg" },
    { "type": "text", "id": "image_alt", "label": "Alt-tekst foto", "default": "Wim en Sabrina met een kop koffie voor hun brander" },
    { "type": "text", "id": "image_position", "label": "Focuspunt foto", "default": "30% center" },
    { "type": "text", "id": "script", "label": "Handschriftregel", "default": "Wim & Sabrina" },
    { "type": "text", "id": "heading", "label": "Titel", "default": "Het begon met één kop koffie op een terras in Tarbes." },
    { "type": "richtext", "id": "text", "label": "Tekst", "default": "<p>In 2013 proefde Wim in de Pyreneeën een koffie die geen melk of suiker nodig had. Terug thuis werd de hobbyruimte een branderij, en in 2015 rolde de eerste branding uit de trommel.</p>" },
    { "type": "text", "id": "link_label", "label": "Linktekst", "default": "Lees ons verhaal" },
    { "type": "url", "id": "link", "label": "Link" },
    { "type": "color_scheme", "id": "color_scheme", "label": "t:sections.all.colors.label", "default": "scheme-3" }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Cijfer",
      "settings": [
        { "type": "text", "id": "number", "label": "Cijfer", "default": "2015" },
        { "type": "text", "id": "label", "label": "Uitleg", "default": "Eerste branding" }
      ]
    }
  ],
  "presets": [{ "name": "ROSS · Verhaal", "blocks": [{ "type": "stat" }] }]
}
{% endschema %}
