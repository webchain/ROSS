<section class="ross-overlay">
  {%- render 'ross-image',
    image: section.settings.image,
    fallback: section.settings.fallback,
    alt: section.settings.image_alt,
    position: section.settings.image_position,
    sizes: '100vw',
    class: 'ross-overlay__img'
  -%}
  <div class="ross-overlay__box color-{{ section.settings.color_scheme }}">
    {%- if section.settings.script != blank -%}
      <p class="ross-script ross-kicker ross-kicker--yellow">{{ section.settings.script | escape }}</p>
    {%- endif -%}
    <h2 class="ross-h3">{{ section.settings.heading | escape }}</h2>
    {%- if section.settings.text != blank -%}
      <div class="ross-lead rte">{{ section.settings.text }}</div>
    {%- endif -%}
    <div class="ross-buttons">
      {%- if section.settings.button_label_1 != blank -%}
        <a href="{{ section.settings.button_link_1 | default: '#' }}" class="button">{{ section.settings.button_label_1 | escape }}</a>
      {%- endif -%}
      {%- if section.settings.button_label_2 != blank -%}
        <a href="{{ section.settings.button_link_2 | default: '#' }}" class="button button--secondary">{{ section.settings.button_label_2 | escape }}</a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "ROSS · Foto met kader",
  "tag": "div",
  "class": "section ross-section",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Foto" },
    { "type": "text", "id": "fallback", "label": "Standaardfoto (themabestand)", "default": "ross-koffiebar-veldrit.jpg" },
    { "type": "text", "id": "image_alt", "label": "Alt-tekst foto", "default": "De zwarte ROSS-koffiebar op een modderige veldrit, met een rij wachtende supporters" },
    { "type": "text", "id": "image_position", "label": "Focuspunt foto", "default": "center" },
    { "type": "text", "id": "script", "label": "Handschriftregel", "default": "De mobiele koffiebar" },
    { "type": "text", "id": "heading", "label": "Titel", "default": "Regen, modder, veldrit? Wij staan er." },
    { "type": "richtext", "id": "text", "label": "Tekst", "default": "<p>Op je bedrijfsfeest, je trouw of aan de finish.</p>" },
    { "type": "text", "id": "button_label_1", "label": "Knop 1", "default": "Boek de koffiebar" },
    { "type": "url", "id": "button_link_1", "label": "Link knop 1" },
    { "type": "text", "id": "button_label_2", "label": "Knop 2" },
    { "type": "url", "id": "button_link_2", "label": "Link knop 2" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Kleur van het kader", "default": "scheme-3" }
  ],
  "presets": [{ "name": "ROSS · Foto met kader" }]
}
{% endschema %}
