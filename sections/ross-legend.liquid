<section class="ross-legend color-{{ section.settings.color_scheme }}">
  <div class="page-width ross-split__inner">
    <div class="ross-split__text">
      {%- if section.settings.script != blank -%}
        <p class="ross-script ross-kicker">{{ section.settings.script | escape }}</p>
      {%- endif -%}
      <h2 class="ross-h2">{{ section.settings.heading | escape }}</h2>
      {%- if section.settings.text != blank -%}
        <div class="ross-lead rte">{{ section.settings.text }}</div>
      {%- endif -%}
      <ul class="ross-legend__list" role="list">
        {%- for block in section.blocks -%}
          <li {{ block.shopify_attributes }}>
            {%- liquid
              assign legend_url = section.settings.collection_url
              if legend_url != blank and block.settings.key != blank
                assign legend_url = legend_url | append: '?kleur=' | append: block.settings.key
              endif
            -%}
            {%- if legend_url != blank -%}<a href="{{ legend_url }}">{%- endif -%}
            <span class="ross-legend__swatch" style="background: {{ block.settings.color }}" aria-hidden="true"></span>
            <strong>{{ block.settings.name | escape }}</strong>
            <span class="ross-legend__taste">{{ block.settings.taste | escape }}</span>
            {%- if legend_url != blank -%}</a>{%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    </div>
    <div class="ross-split__media ross-legend__media">
      {%- render 'ross-image',
        image: section.settings.image,
        fallback: 'ross-zakken-groep.webp',
        alt: section.settings.image_alt,
        sizes: '(min-width: 990px) 50vw, 100vw',
        class: 'ross-legend__img'
      -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "ROSS · Kleurlegende",
  "tag": "div",
  "class": "section ross-section",
  "max_blocks": 8,
  "settings": [
    { "type": "text", "id": "script", "label": "Handschriftregel", "default": "Elke regio, een eigen kleur" },
    { "type": "text", "id": "heading", "label": "Titel", "default": "Welke kleur drink jij?" },
    { "type": "richtext", "id": "text", "label": "Tekst", "default": "<p>Op elk ROSS-label zie je meteen waar de koffie vandaan komt. Onthoud je kleur, en je vindt je favoriet zo terug: online, in de winkel en op het rek.</p>" },
    { "type": "url", "id": "collection_url", "label": "Link naar de koffiecollectie", "info": "Elke kleur linkt dan naar de collectie, gefilterd op die kleur." },
    { "type": "image_picker", "id": "image", "label": "Foto", "info": "Leeg = de vijf ROSS-zakken." },
    { "type": "text", "id": "image_alt", "label": "Alt-tekst foto", "default": "Vijf ROSS-koffiezakken naast elkaar, elk met een andere labelkleur" },
    { "type": "color_scheme", "id": "color_scheme", "label": "t:sections.all.colors.label", "default": "scheme-1" }
  ],
  "blocks": [
    {
      "type": "color",
      "name": "Kleur",
      "settings": [
        { "type": "text", "id": "name", "label": "Naam", "default": "Bruin" },
        { "type": "color", "id": "color", "label": "Kleur", "default": "#7B4B2A" },
        { "type": "text", "id": "taste", "label": "Uitleg", "default": "Huisblends Mercator en Reynaert" },
        {
          "type": "select",
          "id": "key",
          "label": "Filter in de collectie",
          "options": [
            { "value": "bruin", "label": "Bruin" },
            { "value": "oranje", "label": "Oranje" },
            { "value": "rood", "label": "Rood" },
            { "value": "paars", "label": "Paars" },
            { "value": "geel", "label": "Geel" },
            { "value": "grijs", "label": "Grijs" }
          ],
          "default": "bruin"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "ROSS · Kleurlegende",
      "blocks": [{ "type": "color" }]
    }
  ]
}
{% endschema %}
