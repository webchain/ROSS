<section class="ross-split color-{{ section.settings.color_scheme }}{% if section.settings.image_right %} ross-split--reverse{% endif %}">
  <div class="page-width ross-split__inner">
    <div class="ross-split__media">
      {%- render 'ross-image',
        image: section.settings.image,
        fallback: section.settings.fallback,
        alt: section.settings.image_alt,
        position: section.settings.image_position,
        sizes: '(min-width: 990px) 50vw, 100vw',
        class: 'ross-split__img'
      -%}
    </div>
    <div class="ross-split__text">
      {%- if section.settings.script != blank -%}
        <p class="ross-script ross-kicker">{{ section.settings.script | escape }}</p>
      {%- endif -%}
      {%- assign heading_tag = section.settings.heading_tag | default: 'h2' -%}
      <{{ heading_tag }} class="ross-h2">{{ section.settings.heading | escape }}</{{ heading_tag }}>
      {%- if section.settings.text != blank -%}
        <div class="ross-lead rte">{{ section.settings.text }}</div>
      {%- endif -%}
      {%- if section.blocks.size > 0 -%}
        <dl class="ross-hours">
          {%- for block in section.blocks -%}
            <dt {{ block.shopify_attributes }}>{{ block.settings.label | escape }}</dt>
            <dd>{{ block.settings.value | escape }}</dd>
          {%- endfor -%}
        </dl>
      {%- endif -%}
      {%- if section.settings.note != blank -%}
        <div class="ross-note rte">{{ section.settings.note }}</div>
      {%- endif -%}
      <div class="ross-buttons">
        {%- if section.settings.button_label_1 != blank -%}
          <a href="{{ section.settings.button_link_1 | default: '#' }}" class="button">{{ section.settings.button_label_1 | escape }}</a>
        {%- endif -%}
        {%- if section.settings.button_label_2 != blank -%}
          <a href="{{ section.settings.button_link_2 | default: '#' }}" class="button button--secondary">{{ section.settings.button_label_2 | escape }}</a>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "ROSS · Foto en tekst",
  "tag": "div",
  "class": "section ross-section",
  "max_blocks": 8,
  "settings": [
    { "type": "checkbox", "id": "image_right", "label": "Foto rechts", "default": false },
    { "type": "image_picker", "id": "image", "label": "Foto" },
    { "type": "text", "id": "fallback", "label": "Standaardfoto (themabestand)", "default": "ross-krat-levering.jpg" },
    { "type": "text", "id": "image_alt", "label": "Alt-tekst foto", "default": "Een kist vol verse ROSS-koffiezakjes, klaar om te leveren" },
    { "type": "text", "id": "image_position", "label": "Focuspunt foto", "default": "center" },
    { "type": "text", "id": "script", "label": "Handschriftregel", "default": "Het koffie-abonnement" },
    { "type": "text", "id": "heading", "label": "Titel", "default": "Vrijdag is koffiedag." },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Soort titel",
      "options": [
        { "value": "h1", "label": "Paginatitel (h1)" },
        { "value": "h2", "label": "Sectietitel (h2)" }
      ],
      "default": "h2",
      "info": "Kies h1 als deze sectie bovenaan een pagina staat."
    },
    { "type": "richtext", "id": "text", "label": "Tekst", "default": "<p>Elke week of om de twee weken verse koffie in je brievenbus.</p>" },
    { "type": "richtext", "id": "note", "label": "Kleine tekst onder de lijst" },
    { "type": "text", "id": "button_label_1", "label": "Knop 1", "default": "Start je abonnement" },
    { "type": "url", "id": "button_link_1", "label": "Link knop 1" },
    { "type": "text", "id": "button_label_2", "label": "Knop 2" },
    { "type": "url", "id": "button_link_2", "label": "Link knop 2" },
    { "type": "color_scheme", "id": "color_scheme", "label": "t:sections.all.colors.label", "default": "scheme-1" }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "Rij (bv. openingsuren)",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Woensdag" },
        { "type": "text", "id": "value", "label": "Waarde", "default": "8u – 12u30" }
      ]
    }
  ],
  "presets": [{ "name": "ROSS · Foto en tekst" }]
}
{% endschema %}
