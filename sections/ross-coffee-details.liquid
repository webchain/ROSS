{%- liquid
  assign mf = product.metafields.custom
  assign ross_name = mf.koffienaam.value | default: product.title
  assign has_any = false
  if mf.herkomst != blank or mf.verwerking != blank or mf.waarom != blank or mf.oogst != blank
    assign has_any = true
  endif
-%}
{%- if has_any or mf.tips != blank -%}
  <section class="ross-details color-{{ section.settings.color_scheme }}">
    <div class="page-width ross-details__inner">
      {%- if has_any -%}
        <div class="ross-details__main">
          <h2 class="ross-h3">{{ section.settings.heading | replace: '[naam]', ross_name | escape }}</h2>
          {%- if mf.herkomst != blank -%}
            <details class="ross-acc" open>
              <summary>Herkomst</summary>
              <div class="ross-acc__body">{{ mf.herkomst.value | newline_to_br }}</div>
            </details>
          {%- endif -%}
          {%- if mf.verwerking != blank -%}
            <details class="ross-acc">
              <summary>Variëteit en verwerking</summary>
              <div class="ross-acc__body">{{ mf.verwerking.value | newline_to_br }}</div>
            </details>
          {%- endif -%}
          {%- if mf.waarom != blank -%}
            <details class="ross-acc">
              <summary>Waarom deze koffie bijzonder is</summary>
              <div class="ross-acc__body">{{ mf.waarom.value | newline_to_br }}</div>
            </details>
          {%- endif -%}
          {%- if mf.oogst != blank -%}
            <details class="ross-acc">
              <summary>Oogstperiodes</summary>
              <div class="ross-acc__body">{{ mf.oogst.value }}</div>
            </details>
          {%- endif -%}
          {%- if section.settings.show_description and product.description != blank -%}
            <details class="ross-acc">
              <summary>Volledige beschrijving</summary>
              <div class="ross-acc__body rte">{{ product.description }}</div>
            </details>
          {%- endif -%}
        </div>
      {%- endif -%}
      {%- if mf.tips != blank -%}
        <aside class="ross-details__tip color-scheme-3">
          <p class="ross-script ross-kicker ross-kicker--yellow">{{ section.settings.tip_heading | escape }}</p>
          <p class="ross-details__tiptext">{{ mf.tips.value | newline_to_br }}</p>
        </aside>
      {%- endif -%}
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "ROSS · Over de koffie",
  "tag": "div",
  "class": "section ross-section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Titel", "default": "Alles over [naam]", "info": "[naam] wordt de koffienaam." },
    { "type": "text", "id": "tip_heading", "label": "Titel van het zwarte kader", "default": "Ideaal voor" },
    { "type": "checkbox", "id": "show_description", "label": "Toon ook de volledige productbeschrijving", "default": true },
    { "type": "color_scheme", "id": "color_scheme", "label": "t:sections.all.colors.label", "default": "scheme-1" }
  ],
  "enabled_on": { "templates": ["product"] }
}
{% endschema %}
